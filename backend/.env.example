SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Base de données (PostgreSQL en production)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=weeb
# DB_USER=weeb
# DB_PASSWORD=weeb
# DB_HOST=localhost
# DB_PORT=5432

# Email (console en dev, SMTP en production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@weeb.local

# Monitoring (optionnel)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
MONITORING_ERROR_RATE_THRESHOLD=0.1
MONITORING_LATENCY_P95_THRESHOLD_MS=1000
MONITORING_MIN_REQUESTS_FOR_ALERT=10
LOG_LEVEL=INFO

# Production (DEBUG=False)
# ALLOWED_HOSTS=votre-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://votre-frontend.onrender.com
# FRONTEND_URL=https://votre-frontend.onrender.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
