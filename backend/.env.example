# Développement local
DJANGO_SETTINGS_MODULE=config.development
SECRET_KEY=change-me-en-dev
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@weeb.local

# Monitoring (optionnel)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# MONITORING_ERROR_RATE_THRESHOLD=0.1
# MONITORING_LATENCY_P95_THRESHOLD_MS=1000
# MONITORING_MIN_REQUESTS_FOR_ALERT=10

