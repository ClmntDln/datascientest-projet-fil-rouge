# Dev local : proxy Vite (pas de CORS) — recommandé
VITE_API_URL=/api

# Vercel + Render : URL complète de l'API Render
# VITE_API_URL=https://datascientest-projet-fil-rouge.onrender.com/api

# Docker prod : laisser /api (nginx proxy vers le backend)
# Build : docker build --build-arg VITE_API_URL=/api -t weeb-frontend .
# Run   : docker run -p 8080:80 -e BACKEND_URL=http://weeb-backend:8000 weeb-frontend

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
